# IntelliJ Run Configuration > Environment variables 또는
# 터미널 export / direnv 등으로 주입하면 됩니다.
# (이 파일은 예시이며, 실제 .env는 git에 올리지 마세요.)

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/boardingpass?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=boardingpass
SPRING_DATASOURCE_PASSWORD=mypassword

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=mypassword

JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-bytes
JWT_EXPIRATION=3600000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_SERVER_URL=http://localhost:8080

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=mcmboardingpass;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=uploads

KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

OPENAI_API_KEY=sk-proj-12345
OPENAI_TIMEOUT_SECONDS=120